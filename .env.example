# MCP server — local development configuration.
#
# Loaded automatically via `import "dotenv/config"` (see src/index.ts). In
# production there is no .env file: App Runner injects these as env vars at
# deploy time (set by the CDK in ../infra). Copy this file to `.env` (which is
# gitignored), then uncomment and fill in only the settings for backends you
# actually run. An optional backend's tools are advertised only when all of its
# required variables are set; see each section below for those requirements.

# --- Transport ---
# 'stdio' (default) for direct testing / the MCP inspector; 'http' so the local
# Bridge can reach MCP at http://localhost:3000/mcp.
MCP_TRANSPORT=stdio
# PORT=3000              # http transport only; defaults to 3000
# MCP_SERVER_KEY=        # shared key for Bridge -> MCP auth; omit locally

# --- Lex (semantic-search backend) ---
# Uncomment to offer the semantic-search tools — including when Lex is at the
# default address, since the http://localhost:8000 default belongs to the client
# and does not stand in for the variable.
# SEMANTIC_API_BASE_URL=http://localhost:8000
# SEMANTIC_API_KEY=

# --- Research API (research.legislation.gov.uk) ---
# Both the username and the password are needed — with only one, every request
# would 401. The base URL has a working default and does not gate anything.
# RESEARCH_API_BASE_URL=
# RESEARCH_API_USERNAME=
# RESEARCH_API_PASSWORD=

# --- Duties dataset backend (Aurora Postgres via the RDS Data API) ---
# Cluster ARN + a credentials secret ARN. Required for the duties tools; if
# either is unset the tools are simply not registered — the same pattern the
# semantic and Research API tools follow. There is no backend selector —
# presence of these two is what enables them.
#
# There are TWO secrets on this cluster, and which one you put in
# DUTIES_DB_SECRET_ARN decides what your local server can do:
#
#   SecretArn            master (`duties_admin`) — full read/write. Needed by
#                        the schema, ingest and role-provisioning scripts.
#                        OPERATOR USE ONLY: the deployed service never
#                        receives it.
#   McpReadOnlySecretArn the `mcp_ro` role — read-only. This is what App
#                        Runner is given, so it is the truest local mirror of
#                        production; prefer it unless you are ingesting.
#
# Find them in the DataStack outputs:
#   aws cloudformation describe-stacks --stack-name LegislationChatData \
#     --profile jd-tna --region eu-west-2 \
#     --query "Stacks[0].Outputs[?ends_with(OutputKey,'Arn')||OutputKey=='ClusterArn']"
# DUTIES_DB_CLUSTER_ARN=arn:aws:rds:eu-west-2:<account-id>:cluster:legislation-duties
# DUTIES_DB_SECRET_ARN=arn:aws:secretsmanager:eu-west-2:<account-id>:secret:<secret-name>
# DUTIES_DB_NAME=duties  # defaults to 'duties'

# Read-only role provisioning (scripts/apply-readonly-role.js only). That script
# authenticates with the MASTER secret above and provisions the role described
# by this one, so both must be set — and set to different secrets — when you
# run it. Not read by the server.
# DUTIES_DB_RO_SECRET_ARN=arn:aws:secretsmanager:eu-west-2:<account-id>:secret:<secret-name>
#
# Role names the script expects. Both default to what DataStack creates
# (masterUsername / mcpReadOnlyUsername in infra/lib/data-stack.ts), and the
# script refuses a read-only secret that names the master or any other role —
# so set DUTIES_DB_RO_USERNAME only when deliberately provisioning a
# differently named one.
# DUTIES_DB_MASTER_USERNAME=duties_admin
# DUTIES_DB_RO_USERNAME=mcp_ro

# --- AWS credentials for the Data API ---
# The RDS Data API client uses the default AWS credential chain. For the server,
# the identity needs rds-data:ExecuteStatement on the cluster and
# secretsmanager:GetSecretValue on whichever secret DUTIES_DB_SECRET_ARN names.
# Running apply-readonly-role.js needs the same rds-data:ExecuteStatement, plus
# GetSecretValue on BOTH secrets: it runs its DDL through the master one, and
# reads and logs in with the read-only one.
AWS_PROFILE=jd-tna
# AWS_REGION=eu-west-2   # defaults to eu-west-2 (where the cluster lives)
